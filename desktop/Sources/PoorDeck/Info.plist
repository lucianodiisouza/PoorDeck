<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>PoorDeck</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Menu-bar app: no Dock icon. The config window is opened on demand. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Local network access is required to serve the client and accept
	     WebSocket connections from phones/tablets on the same Wi-Fi. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>PoorDeck serves its control surface to your phone or tablet over your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_poordeck._tcp</string>
	</array>
	<!-- Per-app volume needs to tap other apps' audio. macOS shows this string
	     in the TCC prompt the first time the user adjusts an app's volume. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>PoorDeck captures other apps' audio to control their volume individually.</string>
	<!-- Registers the `.pdpack` extension as a real UTI (conforming to JSON).
	     Without this, UTType(filenameExtension:) yields a throwaway dynamic
	     type: NSSavePanel still exports fine, but NSOpenPanel greys out the
	     saved packs so they can't be imported. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.oprimo.poordeck.pack</string>
			<key>UTTypeDescription</key>
			<string>PoorDeck Pack</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pdpack</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Makes PoorDeck the owning app for `.pdpack` files so double-clicking
	     one in Finder launches the app and hands it to the open handler in
	     AppDelegate (which imports the pack's pages). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PoorDeck Pack</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>dev.oprimo.poordeck.pack</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
